#!/usr/bin/env bash
# Sourced by other bin/ scripts. Fails with a clear message if the required
# compose service isn't running.
set -euo pipefail

_require_service() {
  local service="$1"
  if ! docker compose ps --status running --services 2>/dev/null | grep -qx "$service"; then
    echo "error: '$service' container is not running." >&2
    echo "       Run 'bin/setup' (first time) or 'docker compose up -d' to start it." >&2
    exit 1
  fi
}
