#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

if ! command -v docker >/dev/null 2>&1; then
  echo "error: 'docker' not found on the host." >&2
  echo "       Install Docker Desktop (macOS) or Docker Engine + Compose (WSL2/Linux)" >&2
  echo "       and make sure it's running, then re-run bin/setup." >&2
  exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
  echo "error: 'docker compose' is not available." >&2
  echo "       Install/update Docker to a version that includes the Compose plugin." >&2
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "error: Docker is installed but not running (or not reachable)." >&2
  echo "       Start Docker Desktop / the Docker daemon, then re-run bin/setup." >&2
  exit 1
fi

echo "==> Building and starting containers"
docker compose up -d --build

echo "==> Waiting for postgres"
until docker compose exec -T postgres pg_isready -U booking -d booking >/dev/null 2>&1; do
  sleep 1
done

echo "==> Installing backend dependencies (composer)"
docker compose exec -T php composer install

echo "==> Running migrations (phinx)"
docker compose exec -T php vendor/bin/phinx migrate

echo "==> Installing frontend dependencies (npm)"
docker compose exec -T node npm ci

echo "==> Installing git hooks (lefthook)"
bin/_install-lefthook
git config core.hooksPath .githooks

echo "==> Checking backend health"
for i in $(seq 1 20); do
  if curl -sf http://localhost:8080/api/health >/dev/null; then
    echo "    backend OK"
    break
  fi
  sleep 1
done

echo
echo "Setup complete."
echo "  Frontend: http://localhost:5173"
echo "  Backend:  http://localhost:8080/api/health"
echo
echo "To tear everything down (containers, volumes, and the Postgres data):"
echo "  docker compose down -v"
